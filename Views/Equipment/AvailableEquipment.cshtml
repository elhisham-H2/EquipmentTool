@model IEnumerable<EquipmentTool.Models.Equipment>
@{
    ViewData["Title"] = "Available Equipment";
}

<h2 class="mb-4">Available Equipment</h2>

<table class="table table-hover align-middle">
    <thead class="table-success">
        <tr>
            <th>ID</th>
            <th>Type</th>
            <th>Description</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Type</td>
                <td>@item.Description</td>
                <td>
                    <span class="badge bg-success">Ready to Loan</span>
                </td>
            </tr>
        }
    </tbody>
</table>
