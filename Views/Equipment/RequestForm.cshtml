@model EquipmentTool.Models.EquipmentRequest
@{
    ViewData["Title"] = "Request Form";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <h2 class="mb-4">Equipment Request Form</h2>

        <form asp-action="RequestForm" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label">Phone Number</label>
                <input asp-for="PhoneNumber" class="form-control" placeholder="905-922-2222" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Role" class="form-label"></label>
                <select asp-for="Role" asp-items="Html.GetEnumSelectList<EquipmentTool.Models.UserRole>()"
                        class="form-select">
                    <option selected="selected" value="">Please select your role</option>
                </select>
                <span asp-validation-for="Role" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EquipmentType" class="form-label">Equipment Type</label>
                <select asp-for="EquipmentType" asp-items="Html.GetEnumSelectList<EquipmentTool.Models.EquipmentType>()"
                        class="form-select">
                    <option selected="selected" value="">Please select the device type</option>
                </select>
                <span asp-validation-for="EquipmentType" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="RequestDetails" class="form-label">Request Details</label>
                <textarea asp-for="RequestDetails" class="form-control" rows="3"></textarea>
                <span asp-validation-for="RequestDetails" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DurationInDays" class="form-label">Duration (number of days)</label>
                <input asp-for="DurationInDays" class="form-control" type="number" />
                <span asp-validation-for="DurationInDays" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Submit Request</button>
        </form>
    </div>
</div>
