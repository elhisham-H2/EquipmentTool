@model EquipmentTool.Models.EquipmentRequest
@{
    ViewData["Title"] = "Confirmation";
}

<div class="alert alert-success mt-4 p-4">
    <h2 class="alert-heading">Thank you, @Model.Name!</h2>
    <p class="lead">Your request has been submitted successfully (Request ID: #@Model.Id).</p>
    <hr />
    <p class="mb-0">IT will be in touch with you soon regarding your requested @Model.EquipmentType.</p>
</div>
<div class="mt-3">
    <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Return to Home</a>
</div>
